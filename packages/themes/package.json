{
  "name": "@oppulence/themes",
  "version": "0.1.1",
  "description": "Brand theme CSS for Oppulence apps - Eigenn, Conduitt, and Cossistant Tailwind v4 themes",
  "type": "module",
  "exports": {
    "./eigenn.css": "./eigenn.css",
    "./conduitt.css": "./conduitt.css",
    "./cossistant.css": "./cossistant.css"
  },
  "files": [
    "eigenn.css",
    "conduitt.css",
    "cossistant.css",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oppulence-Engineering/design-system.git",
    "directory": "packages/themes"
  },
  "license": "MIT",
  "keywords": [
    "design-system",
    "theme",
    "css",
    "tailwindcss"
  ],
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "prettier --check .",
    "typecheck": "echo 'CSS-only package: no TypeScript to check'",
    "build": "tailwindcss -i check/eigenn.css -o /dev/null && tailwindcss -i check/conduitt.css -o /dev/null && tailwindcss -i check/cossistant.css -o /dev/null"
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "tailwindcss": "^4.1.8"
  }
}
