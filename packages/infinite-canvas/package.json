{
  "name": "@oppulence/infinite-canvas",
  "version": "0.3.2",
  "description": "Infinite canvas spatial editor for HTML/React designs — DOM artboards, layers, inspector, undo/redo, pluggable collaboration",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./document": {
      "types": "./src/document/index.ts",
      "import": "./src/document/index.ts",
      "default": "./src/document/index.ts"
    },
    "./headless": {
      "types": "./src/headless/index.ts",
      "import": "./src/headless/index.ts",
      "default": "./src/headless/index.ts"
    },
    "./panels": {
      "types": "./src/panels/index.ts",
      "import": "./src/panels/index.ts",
      "default": "./src/panels/index.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./src/agent/index.ts",
      "default": "./src/agent/index.ts"
    },
    "./export": {
      "types": "./src/export/index.ts",
      "import": "./src/export/index.ts",
      "default": "./src/export/index.ts"
    },
    "./collab": {
      "types": "./src/collab/index.ts",
      "import": "./src/collab/index.ts",
      "default": "./src/collab/index.ts"
    },
    "./collab/yjs": {
      "types": "./src/collab/yjs/index.ts",
      "import": "./src/collab/yjs/index.ts",
      "default": "./src/collab/yjs/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./styles.css": "./src/styles/canvas.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oppulence-Engineering/design-system.git",
    "directory": "packages/infinite-canvas"
  },
  "license": "MIT",
  "keywords": [
    "canvas",
    "infinite-canvas",
    "design-tool",
    "react",
    "editor",
    "collaboration",
    "yjs",
    "crdt"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" && bun run lint:boundaries",
    "lint:boundaries": "node scripts/check-import-boundaries.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react-colorful": "^5.6.1"
  },
  "peerDependencies": {
    "@hocuspocus/provider": "^3.4.0",
    "@oppulence/design-system": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "y-protocols": "^1.0.0",
    "yjs": "^13.6.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@hocuspocus/provider": {
      "optional": true
    },
    "@oppulence/design-system": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "y-protocols": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hocuspocus/provider": "^3.4.4",
    "@oppulence/design-system": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "fast-check": "^3.23.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  }
}
