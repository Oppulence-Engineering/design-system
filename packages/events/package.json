{
  "name": "@oppulence/events",
  "version": "1.0.1",
  "description": "Typed analytics events and OpenPanel adapters for Oppulence applications",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./corinthian": {
      "types": "./dist/corinthian.d.ts",
      "import": "./dist/corinthian.js",
      "default": "./dist/corinthian.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "default": "./dist/identity.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js",
      "default": "./dist/gate.js"
    },
    "./server-tracker": {
      "types": "./dist/server-tracker.d.ts",
      "import": "./dist/server-tracker.js",
      "default": "./dist/server-tracker.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oppulence-Engineering/design-system.git",
    "directory": "packages/events"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run build:server && bun run build:client && bun run verify:artifacts",
    "build:client": "bun build src/client.tsx src/identity.ts --root src --outdir dist --target browser --format esm --packages=external --banner='\"use client\";'",
    "build:server": "bun build src/index.ts src/server.ts src/corinthian.ts src/events.ts src/gate.ts src/server-tracker.ts src/types.ts --root src --outdir dist --target node --format esm --packages=external",
    "clean": "rm -rf .turbo dist tsconfig.build.tsbuildinfo",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx}\"",
    "lint": "prettier --check \"{src,tests}/**/*.{ts,tsx}\"",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "verify:artifacts": "bun test tests/artifacts.test.ts"
  },
  "dependencies": {
    "@openpanel/nextjs": "^1.0.8",
    "@openpanel/sdk": "1.3.1",
    "@vercel/functions": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
