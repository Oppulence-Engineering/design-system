{
  "name": "@oppulence/integrations",
  "version": "0.3.1",
  "description": "Browser-safe integration catalogue, contracts, parity reporting, and directory helpers for Oppulence products",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./connection": {
      "types": "./dist/connection.d.ts",
      "import": "./dist/connection.js",
      "default": "./dist/connection.js"
    },
    "./documentation": {
      "types": "./dist/documentation.d.ts",
      "import": "./dist/documentation.js",
      "default": "./dist/documentation.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js",
      "default": "./dist/discovery.js"
    },
    "./golden-journey": {
      "types": "./dist/golden-journey.d.ts",
      "import": "./dist/golden-journey.js",
      "default": "./dist/golden-journey.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js",
      "default": "./dist/kit.js"
    },
    "./parity": {
      "types": "./dist/parity.d.ts",
      "import": "./dist/parity.js",
      "default": "./dist/parity.js"
    },
    "./provider-protocols": {
      "types": "./dist/provider-protocols.d.ts",
      "import": "./dist/provider-protocols.js",
      "default": "./dist/provider-protocols.js"
    },
    "./execution-strategy": {
      "types": "./dist/execution-strategy.d.ts",
      "import": "./dist/execution-strategy.js",
      "default": "./dist/execution-strategy.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./reliability": {
      "types": "./dist/reliability.d.ts",
      "import": "./dist/reliability.js",
      "default": "./dist/reliability.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "import": "./dist/support.js",
      "default": "./dist/support.js"
    },
    "./surfaces": {
      "types": "./dist/surfaces.d.ts",
      "import": "./dist/surfaces.js",
      "default": "./dist/surfaces.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "browser": "./dist/server/browser.js",
      "node": "./dist/server/index.js",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js",
      "default": "./dist/templates.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist/**/*.d.ts",
    "dist/index.js",
    "dist/catalog.js",
    "dist/contracts.js",
    "dist/connection.js",
    "dist/documentation.js",
    "dist/discovery.js",
    "dist/golden-journey.js",
    "dist/kit.js",
    "dist/parity.js",
    "dist/provider-protocols.js",
    "dist/execution-strategy.js",
    "dist/registry.js",
    "dist/reliability.js",
    "dist/support.js",
    "dist/surfaces.js",
    "dist/templates.js",
    "dist/react.js",
    "dist/server/index.js",
    "dist/server/browser.js",
    "dist/integrations.manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oppulence-Engineering/design-system.git",
    "directory": "packages/integrations"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run build:root && bun run build:subpaths && bun run build:server && bun run build:server-browser && bun run build:react && bun run build:manifest && bun run verify:artifacts",
    "build:manifest": "bun scripts/build-public-manifest.ts",
    "build:react": "bun build src/react.tsx --outdir dist --target browser --format esm --packages=external --banner='\"use client\";'",
    "build:root": "esbuild src/index.ts --bundle --platform=browser --format=esm --packages=external --outfile=dist/index.js",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "build:server-browser": "esbuild src/server/browser.ts --bundle --platform=browser --format=esm --outfile=dist/server/browser.js",
    "build:subpaths": "bun build src/catalog.ts src/contracts.ts src/connection.ts src/documentation.ts src/discovery.ts src/golden-journey.ts src/kit.ts src/parity.ts src/provider-protocols.ts src/execution-strategy.ts src/registry.ts src/reliability.ts src/support.ts src/surfaces.ts src/templates.ts --root src --outdir dist --target browser --format esm --packages=external",
    "clean": "rm -rf .turbo dist tsconfig.build.tsbuildinfo",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,tsx}\"",
    "lint": "prettier --check \"{src,tests,scripts}/**/*.{ts,tsx}\"",
    "prepublishOnly": "bun run clean && bun run build",
    "providers:adopt": "bun scripts/openapi-adopt.ts",
    "providers:audit": "bun scripts/audit-packs.ts",
    "providers:coverage": "bun scripts/provider-coverage.ts",
    "providers:generate": "bun scripts/openapi-generate.ts",
    "providers:smoke": "bun scripts/smoke-routes.ts",
    "providers:sync": "bun scripts/sync-gate.ts",
    "providers:verify": "bun scripts/verify-spec-fidelity.ts",
    "providers:wire": "bun scripts/wire-provider.ts",
    "providers:openapi": "bun scripts/openapi-plan.ts",
    "providers:plan": "bun scripts/provider-plan.ts",
    "providers:scaffold": "bun scripts/provider-scaffold.ts",
    "refresh:simstudio": "bun scripts/refresh-simstudio-baseline.ts",
    "test": "bun test tests --path-ignore-patterns='**/artifacts.test.ts'",
    "typecheck": "tsc --noEmit",
    "verify:artifacts": "bun test tests/artifacts.test.ts"
  },
